# Copy frontend/.env.example to frontend/.env.local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Set in the backend shell; comma-separated exact origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Future PostgreSQL integration (not used in Sprint 1)
# DATABASE_URL=postgresql://user:password@localhost:5432/coco
# Local model runtime. Only literal loopback HTTP endpoints are accepted.
COCO_MODEL_ENABLED=true
COCO_LOCAL_MODEL_URL=http://127.0.0.1:8081
COCO_LOCAL_MODEL_NAME=coco-local
COCO_MODEL_TIMEOUT_SECONDS=8
# Known verified cart operations/confirmation skip inference.
COCO_FAST_ORDERING=true
